# ==========================================
# Root .gitignore for Smart Clinic EMR
# ==========================================

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Frontend
**/node_modules/
**/dist/
**/.angular/cache/

# Java / Maven / Backend
**/target/
**/*.class
.mvn/wrapper/maven-wrapper.jar

# IDE & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Excluded documents requested by user
**/README_UC*.md
docs/srs/
*.docx
